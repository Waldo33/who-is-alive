apiVersion: 1
# «База Москвы» переименована в «База игры» (переезд в Европу, 24.11): тот же uid под новым именем
# Grafana не принимает («data source with the same uid already exists») и не запускается — старое имя удалить
deleteDatasources:
  - name: База Москвы
    orgId: 1
datasources:
  - name: Метрики
    uid: vm
    type: prometheus
    access: proxy
    url: http://127.0.0.1:8428
    isDefault: true
  - name: Логи
    uid: vl
    type: victoriametrics-logs-datasource
    access: proxy
    url: http://127.0.0.1:9428
  - name: База игры
    uid: pg
    type: grafana-postgresql-datasource
    access: proxy
    url: 127.0.0.1:{{ game_db_port }}
    user: grafana_ro
    jsonData:
      database: massovka
      sslmode: disable
      postgresVersion: 1600
      timescaledb: false
    secureJsonData:
      password: "{{ pgro_password }}"
