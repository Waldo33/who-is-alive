NODE_ENV=production
PUBLIC_WS_BASE=wss://{{ app_host }}
PUBLIC_API_BASE=https://{{ app_host }}
# свои входы: игрок остаётся на том адресе, через который пришёл (api.benobody.app или запасной <IP>.sslip.io)
PUBLIC_WS_HOSTS={{ app_ws_hosts }}
SITE_URL={{ app_site_url }}
TG_APP_NAME=play
# клипы для Telegram лежат на игровом сервере в Москве — бот (Нидерланды) даёт ссылки туда
CLIP_BASE=https://api.benobody.app
TRUST_PROXY=1
LOG_LEVEL=info
MAX_ROOMS={{ app_max_rooms }}
REGION={{ app_region }}
GEOIP_DB={{ '/opt/massovka/geoip/country.mmdb' if geoip.stat.size | default(0) > 0 else '' }}
EVENTS_UPSTREAM={{ app_events_up }}
