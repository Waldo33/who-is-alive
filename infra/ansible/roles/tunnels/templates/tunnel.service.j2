[Unit]
Description=Массовка: туннель {{ item.desc }}
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/ssh -N -i /etc/massovka/tunnel_ed25519 -o ExitOnForwardFailure=yes -o ConnectTimeout=5 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/etc/massovka/tunnel_known_hosts {{ item.args }} {{ item.to }}
# новые соединения в Москву из-за фильтров проходят через раз (20–40%), уже открытое держится:
# пробуем часто и коротко, а без нужды не переподключаемся
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
