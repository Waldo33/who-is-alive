# Версии и контрольные суммы всего, что выкладка привозит на серверы (game-deploy.yml).
# Обновлять отдельным PR: поменять версию, взять SHA-256 с сайта проекта (файл сумм релиза),
# сверить с суммой скачанного файла. Выкладка сама не берёт «последнюю версию»: неудачный или
# подменённый релиз не уедет в прод без PR (ревью безопасности, N2).
NODE_VERSION=v22.23.5
NODE_SHA256=cdeb8670a0c81f51b4dc4ac61919f9b1ad917b304bf8221eb939570663d240f8
CADDY_VERSION=v2.11.9
CADDY_SHA256=5b8cb7faf8726a2028ad96a66e54e6e81e8f361bc6175e5d22bbd997cc5177fb
NODE_EXPORTER_VERSION=v1.13.1
NODE_EXPORTER_SHA256=5c00c5234f1ee45900b25539a5a0ab82146a098c15c16a4ec3bc855b597a6477
VICTORIA_METRICS_VERSION=v1.157.0
VICTORIA_METRICS_SHA256=7b31192da6cf805b8b9244a904b022948e8022a067a822c30cb9f94600d0c387
VICTORIA_LOGS_VERSION=v1.54.0
VICTORIA_LOGS_SHA256=739e78c82294520b6079bc8a6ae32a1f9fb95a543092929a53a2fe9ab7383016
# Grafana: dl.grafana.com закрыт из среды агента — сумма сверяется с файлом .sha256 того же релиза
# (версия закреплена; чтобы закрепить и сумму, впишите её сюда — тогда сверяется с ней)
GRAFANA_VERSION=v13.3.2
GRAFANA_SHA256=
# страна по адресу (DB-IP Country Lite из npm; целостность проверяет npm по integrity пакета)
GEOIP_VERSION=2.3.2026060120
