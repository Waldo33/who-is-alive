  {
   "id": 14,
   "type": "logs",
   "title": "Ошибки в логах обоих серверов",
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 24,
    "h": 12
   },
   "datasource": {
    "type": "victoriametrics-logs-datasource",
    "uid": "vl"
   },
   "targets": [
    {
     "datasource": {
      "type": "victoriametrics-logs-datasource",
      "uid": "vl"
     },
     "refId": "A",
     "expr": "(level:error OR level:warn OR _msg:~\"(?i)error|fail\") -_SYSTEMD_UNIT:\"massovka-watch.service\"",
     "queryType": "instant"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
