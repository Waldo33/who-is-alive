  {
   "id": 5,
   "type": "timeseries",
   "title": "Случаи по дням",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 7
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pg"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pg"
     },
     "refId": "A",
     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "select d.day::timestamptz as time, case g.source when 'web' then 'телефоны' when 'server' then 'сервер' when 'bot' then 'бот' when 'film' then 'монтаж' else g.source end as metric, sum(d.count) as value\n from error_daily d join error_groups g using (fp) where $__timeFilter(d.day::timestamptz) group by 1, 2 order by 1"
    }
   ],
   "fieldConfig": {
