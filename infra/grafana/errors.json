  {
   "id": 6,
   "type": "table",
   "title": "Ошибки (новые сверху; нажмите — подробности ниже)",
   "description": "Группа — одна и та же ошибка в одном месте кода (без строк и версий). «Где» — файл › функция по картам исходников. «Чаще всего» — платформа, тема, фаза",
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 24,
    "h": 12
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pg"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pg"
     },
     "refId": "A",
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "select case g.source when 'web' then 'телефоны' when 'server' then 'сервер' when 'bot' then 'бот' when 'film' then 'монтаж' else g.source end as откуда, g.title as ошибка, g.culprit as где, g.count as всего,\n coalesce((select sum(d.count) from error_daily d where d.fp = g.fp and $__timeFilter(d.day::timestamptz)), 0) as \"за период\",\n g.first_seen as впервые, g.last_seen as \"в последний раз\", g.last_build as версия,\n (select string_agg(k || ' ' || v, ', ' order by v::bigint desc) from (select k, v from jsonb_each_text(g.tags) as t(k, v) order by v::bigint desc limit 4) x) as \"чаще всего\",\n g.fp\n from error_groups g where $__timeFilter(g.last_seen) order by g.first_seen desc limit 200"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "fp"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Подробно",
          "url": "/grafana/d/massovka-errors/?var-fp=${__data.fields.fp}&${__url_time_range}"
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "ошибка"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Подробно",
          "url": "/grafana/d/massovka-errors/?var-fp=${__data.fields.fp}&${__url_time_range}"
         }
        ]
       },
       {
        "id": "custom.width",
        "value": 520
       }
      ]
     }
    ]
   }
  },
  {
   "id": 7,
   "type": "table",
   "title": "Подробно: последний случай выбранной ошибки",
   "description": "Выберите ошибку в таблице выше (или вставьте fp в поле сверху)",
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 24,
    "h": 14
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pg"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pg"
     },
     "refId": "A",
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "select k as поле, v as значение from (\n  select 1 o, 'ошибка' k, g.title v from error_groups g where g.fp = '$fp'\n  union all select 2, 'где', g.culprit from error_groups g where g.fp = '$fp'\n  union all select 3, 'контекст', (select string_agg(key || ': ' || value, ' · ') from jsonb_each_text(g.sample->'ctx')) from error_groups g where g.fp = '$fp'\n  union all select 4, 'шаги перед ошибкой', (select string_agg(x, '  →  ') from jsonb_array_elements_text(g.sample->'crumbs') x) from error_groups g where g.fp = '$fp'\n  union all select 5, 'стек', g.sample->>'stack' from error_groups g where g.fp = '$fp'\n  union all select 6, 'разбивка', (select string_agg(key || ' ' || value, ', ' order by value::bigint desc) from jsonb_each_text(g.tags)) from error_groups g where g.fp = '$fp'\n  union all select 7, 'версии', g.first_build || ' → ' || g.last_build from error_groups g where g.fp = '$fp'\n ) r order by o"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "cellOptions": {
       "type": "auto",
       "wrapText": true
      }
     }
    },
    "overrides": []
   }
  },
