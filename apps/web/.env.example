# Все переменные необязательны: без них сайт ходит в прод (умолчания — apps/web/src/lib/env.ts).
# Прод собирает .github/workflows/web-deploy.yml.

# свой игровой сервер; для локального (pnpm --filter @kto/server dev) — http://localhost:8080
NEXT_PUBLIC_GAME_API=https://api.benobody.app
# адрес сайта для абсолютных ссылок в превью
NEXT_PUBLIC_SITE_URL=https://benobody.app
# Telegram Mini App («бот/приложение»); пусто — ссылки ведут на сайт
NEXT_PUBLIC_TG_APP=be_nobody_bot/play
# фичи за флагом для всех, через запятую (apps/web/src/lib/features.ts)
NEXT_PUBLIC_FEATURES=
# тестовый контур: плашка «ТЕСТ» и запрет индексации
NEXT_PUBLIC_STAGE=
